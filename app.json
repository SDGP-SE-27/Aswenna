    "name": "Aswenna",
    "slug": "Aswenna",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "package": "com.anonymous.Aswenna",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBLSmnhahYc-ehz6kvDe7D24IthNtZqFN8"
        }
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "extra": {
      "googleMapsApiKey": "AIzaSyBLSmnhahYc-ehz6kvDe7D24IthNtZqFN8"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
