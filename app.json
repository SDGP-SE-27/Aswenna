{
  "expo": {
    "name": "Aswenna",
    "slug": "Aswenna",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "aswenna",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "android"
    ],
    "android": {
      "package": "com.anonymous.Aswenna",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/home_icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/home_icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-font",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "bundleIdentifier": "com.anonymous.Aswenna"
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "f184c853-fcfb-4cfa-95dc-7fee194d37af"
      }
    }
  }
}
